# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf_db

# Security & Authentication
JWT_SECRET=supersecretjwtkey_replace_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Gemini API - Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
# Copy the current Flash model ID from https://aistudio.google.com (names change often)
GEMINI_MODEL=

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment
ENVIRONMENT=development
PORT=8000
