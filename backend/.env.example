# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf_db

# Security & Authentication
# Any random string of 32+ characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Gemini API - Google AI Studio)
# Empty = AI off (keyword rules + manual replies). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model IDs change often: copy current ones from https://aistudio.google.com
# GEMINI_MODEL writes reply drafts; GEMINI_CLASSIFY_MODEL (optional, cheaper) sets category + priority.
GEMINI_MODEL=
GEMINI_CLASSIFY_MODEL=
# Gemini 3 models think before answering; "low" is enough for support replies (cheaper, faster).
# Leave empty only for models without thinking levels.
GEMINI_THINKING_LEVEL=low
AI_TIMEOUT_SECONDS=20

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment
ENVIRONMENT=development
PORT=8000
